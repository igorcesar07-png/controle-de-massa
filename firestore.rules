rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Somente usuários logados (cadastrados pelo responsável) leem e gravam.
    match /apontamentos/{apontamento} {
      allow read, write: if request.auth != null;
      match /{sub=**} {                 // segmentos e leituras de geometria
        allow read, write: if request.auth != null;
      }
    }
    match /viagensFresado/{evento} {    // viagens de fresado (chegada/saída)
      allow read, create, update: if request.auth != null;
      allow delete: if false;           // registros nunca são apagados; correções ficam no histórico
    }
    match /config/{doc} {               // legenda de espessuras de projeto
      allow read, write: if request.auth != null;
    }
  }
}
